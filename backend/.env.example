# Banco SQLite local (caminho relativo à pasta prisma/)
DATABASE_URL="file:./dev.db"

# Porta da API
PORT=3333

# Critério de desempate quando duas ofertas têm o mesmo preço final:
# none | deliveryTime | deliveryFee | productPrice
TIE_BREAKER=deliveryTime

# Fonte de dados por plataforma: mock | official
# "official" só funciona quando houver uma API oficial/autorizada configurada.
PLATFORM_PROVIDER_IFOOD=mock
PLATFORM_PROVIDER_99FOOD=mock
PLATFORM_PROVIDER_KEETA=mock
